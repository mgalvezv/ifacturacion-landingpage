# Orquestador IACFID (solo desarrollo local con backend en c:\Cibercom\projects\IACFID)
# Copia a .env y ajusta. CFID_API_KEY y GROQ_API_KEY van SOLO en el .env de IACFID.

# Modo demo (recomendado para GitHub Pages):
# - En producción (npm run build) SIEMPRE es demo: chat simulado, sin API keys ni backend.
# - Para probar en local con el orquestador real: npm run dev + VITE_CFID_DEMO_MODE=false
# VITE_CFID_DEMO_MODE=true

# URL del orquestador (uvicorn app.main:app --reload --port 8088)
# Solo necesaria si VITE_CFID_DEMO_MODE=false
VITE_CFID_AGENT_API_BASE=http://localhost:8088

# Identificador de sesión para la demo embebida y el widget flotante
VITE_CFID_AGENT_SESSION_ID=cfid-landing-demo

# Acceso Clientes (login CFID embebido en la landing)
# API con /api al final. Debe permitir CORS desde este origen (localhost o GitHub Pages).
VITE_CFID_API_BASE=https://cfid-api.redcibercom.cloud/api
# Portal al que se redirige tras login exitoso (con #cfid_sso=…)
VITE_CFID_APP_URL=https://cfid.redcibercom.cloud

# Demo sin login Aegis (recomendado):
# En IACFID/.env configura CFID_API_KEY=cfid_live_... — el orquestador acepta
# /agent/* sin JWT y el MCP timbra con esa API Key. No pongas la clave aquí.

# Solo si necesitas probar flujo JWT Aegis (puede dar 429 si Aegis limita intentos):
# VITE_CFID_USE_AEGIS_LOGIN=true
# VITE_CFID_DEMO_IDENTIFIER=cibercom
# VITE_CFID_DEMO_PASSWORD=